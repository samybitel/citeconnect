# ===== CiteConnect — variables de production (Docker Compose) =====
# Copiez ce fichier vers .env puis adaptez les valeurs :
#   cp .env.production.example .env
#
# Docker Compose lit automatiquement le fichier .env placé à côté de docker-compose.yml.

# --- Base de données PostgreSQL (conteneur "db") ---
POSTGRES_USER=citeconnect
POSTGRES_DB=citeconnect
# OBLIGATOIRE : changez ce mot de passe. Générez-en un fort, par ex. :
#   openssl rand -hex 24
POSTGRES_PASSWORD=changez-moi-mot-de-passe-fort

# --- Application ---
# URL publique telle que vue par les visiteurs.
#   En production avec HTTPS : https://citeconnect.exemple.fr
#   Le cookie de session devient "secure" automatiquement si cette URL commence par https://
#   Tant que vous testez en HTTP simple (IP du VPS), laissez http://... sinon la connexion échouera.
APP_URL=http://localhost:3000
APP_NAME=CiteConnect

# Port publié sur l'hôte. Derrière un reverse proxy (Nginx/Caddy/Traefik),
# vous pouvez le laisser à 3000 et proxifier vers 127.0.0.1:3000.
APP_PORT=3000

# --- Sessions / authentification ---
SESSION_COOKIE_NAME=cc_session
SESSION_TTL_DAYS=7
BCRYPT_ROUNDS=12

# --- Données de démonstration ---
# true = badges "Fictif" visibles + compte de démo autorisé.
DEMO_MODE=true
# true = (ré)initialise les comptes démo + test à CHAQUE démarrage du conteneur.
# Laissez "false" en production et seedez une seule fois manuellement (voir DEPLOIEMENT.md).
SEED_ON_START=false

# Note : le stockage privé des documents est fixé à /app/storage dans le conteneur
# et persisté via le volume Docker "storage". Aucune variable à changer ici.